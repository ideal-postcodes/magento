{
  "name": "magento",
  "version": "1.0.0",
  "private": true,
  "description": "Ideal Postcodes Magento Extension",
  "main": "index.js",
  "author": {
    "name": "Ideal Postcodes",
    "email": "support@ideal-postcodes.co.uk",
    "url": "https://ideal-postcodes.co.uk"
  },
  "bugs": {
    "url": "https://github.com/ideal-postcodes/magento/issues",
    "email": "support@ideal-postcodes.co.uk"
  },
  "homepage": "https://github.com/ideal-postcodes/magento",
  "repository": {
    "type": "git",
    "url": "https://github.com/ideal-postcodes/magento.git"
  },
  "scripts": {
    "semantic-release": "semantic-release",
    "start": "make bootstrap && make set-base-url",
    "build": "NODE_ENV=production rollup -c",
    "watch": "rollup -cw",
    "lint": "eslint lib/**/*.ts",
    "lint-fix": "eslint lib/**/*.ts --fix",
    "test:e2e": "cypress run --config-file test/e2e/cypress.config.ts",
    "test:e2e:open": "cypress open --config-file test/e2e/cypress.config.ts",
    "test:all": "npm start && npm run test:e2e && make down",
    "test:snapshot": "cypress run --config-file test/snapshot/cypress.config.ts",
    "test:snapshot:open": "cypress open --config-file test/snapshot/cypress.config.ts",
    "test:build": "rollup -c test/snapshot/rollup.config.js",
    "test:watch": "rollup -c test/snapshot/rollup.config.js -w",
    "test": "npm run test:snapshot",
    "test:open": "cypress open --config-file test/snapshot/cypress.config.ts"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node -e \"const fs=require('fs');const {name,version,...rest}=JSON.parse(fs.readFileSync('composer.json','utf8'));fs.writeFileSync('composer.json',JSON.stringify({name,version:'${nextRelease.version}',...rest},null,2)+'\\n')\""
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "composer.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "@ideal-postcodes/address-finder": "~5.2.16",
    "@ideal-postcodes/postcode-lookup": "~3.1.6"
  },
  "devDependencies": {
    "@babel/preset-env": "~7.16.11",
    "@cablanchard/eslint-config": "~2.1.1",
    "@semantic-release/changelog": "~6.0.3",
    "@semantic-release/exec": "~7.1.0",
    "@semantic-release/git": "~10.0.1",
    "@semantic-release/github": "~11.0.0",
    "@cablanchard/tsconfig": "~2.0.0",
    "@ideal-postcodes/api-fixtures": "~1.2.0",
    "@ideal-postcodes/api-typings": "~2.1.0",
    "@ideal-postcodes/jsutil": "~4.6.0",
    "@prettier/plugin-php": "~0.18.4",
    "@prettier/plugin-xml": "~0.13.1",
    "@rollup/plugin-commonjs": "~21.0.2",
    "@rollup/plugin-json": "~4.1.0",
    "@rollup/plugin-node-resolve": "~13.2.0",
    "@types/babel__traverse": "^7.18.3",
    "@types/cypress": "~1.1.3",
    "@types/mocha": "~8.2.2",
    "@types/node": "~14.14.41",
    "@typescript-eslint/eslint-plugin": "~5.17.0",
    "@typescript-eslint/parser": "~5.19.0",
    "@wessberg/rollup-plugin-ts": "~1.3.14",
    "cypress": "~16.2.1",
    "eslint": "~7.32.0",
    "prettier": "~2.2.1",
    "process": "~0.11.10",
    "rollup": "~2.80.0",
    "semantic-release": "~25.0.9",
    "typescript": "~5.9.3",
    "@rollup/plugin-terser": "~0.4.4"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "flatted": "3.4.4",
    "axios": "1.20.0",
    "form-data": "4.0.6",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "@babel/core": "7.29.6",
    "serialize-javascript": "7.1.3",
    "fast-uri": "3.1.9",
    "tmp": "0.2.7",
    "browserslist": "4.28.7",
    "lodash": "4.18.1",
    "qs": "6.16.1",
    "tar": "7.5.21",
    "ip-address": "10.7.5",
    "minimatch@<4": "3.1.5",
    "minimatch@>=7 <11.0.1": "11.0.1",
    "brace-expansion@<2": "1.1.21",
    "brace-expansion@>=2 <3": "2.1.7",
    "picomatch@<3": "2.3.2",
    "picomatch@>=4 <4.0.4": "4.0.4",
    "js-yaml@>=3 <4": "3.15.2",
    "js-yaml@>=4 <5": "4.3.2"
  }
}
