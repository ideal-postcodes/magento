<?xml version="1.0"?>
<!--
    Ideal Postcodes UK Address Search - Hyvä Theme Layout
    
    This layout is used when Hyvä theme is active.
    It loads the binding directly without RequireJS.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Remove the RequireJS-based block on Hyvä pages -->
        <referenceBlock name="idealpostcodes.ukaddresssearch.store" remove="true"/>
        
        <!-- Add Hyvä-compatible block -->
        <referenceBlock name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" 
                   name="idealpostcodes.ukaddresssearch.store.hyva" 
                   template="Idealpostcodes_Ukaddresssearch::store-hyva.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Idealpostcodes\Ukaddresssearch\ViewModel\StoreConfig</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
